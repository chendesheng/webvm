# vscodeT in WebVM: a 32-bit i386 Debian image whose CMD is the native TUI.
#
# The app is cross-compiled on the amd64 builder stage, then copied into an
# i386 buster userland (WebVM/CheerpX only runs 32-bit x86 images). The final
# container is exported to ext2 by the WebVM Deploy workflow.
FROM --platform=linux/amd64 debian:bookworm AS build
ARG DEBIAN_FRONTEND=noninteractive
ARG VSCODET_REF=661d2074c18d1376c008f4434b0f13bd290cffac

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://ziglang.org/download/0.17.1/zig-x86_64-linux-0.17.1.tar.xz \
      -o /tmp/zig.tar.xz \
    && echo "3581863e3cbcfd0fce0efc682ce7e9e93da96668a977791d356a26d2a7e9b17a  /tmp/zig.tar.xz" \
      | sha256sum -c - \
    && tar -xJf /tmp/zig.tar.xz -C /opt \
    && ln -s /opt/zig-x86_64-linux-0.17.1/zig /usr/local/bin/zig

RUN git clone --recurse-submodules --shallow-submodules \
      https://github.com/chendesheng/vscodeT.git /src \
    && cd /src \
    && git checkout "$VSCODET_REF"

WORKDIR /src
RUN scripts/build-onig-i386.sh /src/i386-onig
RUN zig build -Dtarget=x86-linux-musl -Doptimize=ReleaseSmall \
      -Donig-include=/src/third_party/oniguruma/src \
      -Donig-lib=/src/i386-onig
RUN ls -l /src/zig-out/bin/zig

FROM --platform=linux/i386 i386/debian:buster
ARG DEBIAN_FRONTEND=noninteractive

# Do not use useradd: under the i386/qemu build it aborts on the audit
# interface. The WebVM config runs as uid/gid 1000, so create that identity
# directly and keep the tree owned by it.
RUN echo 'user:x:1000:1000:user:/home/user:/bin/bash' >> /etc/passwd \
    && echo 'user:x:1000:' >> /etc/group \
    && mkdir -p /home/user/.vscodet /tmp/vscodet-logs /workspace

COPY --from=build /src/zig-out/bin/zig /usr/local/bin/vscodet
COPY dockerfiles/vscodet-workspace /workspace

RUN chmod 0755 /usr/local/bin/vscodet \
    && chown -R 1000:1000 /home/user /tmp/vscodet-logs /workspace /usr/local/bin/vscodet

WORKDIR /workspace
ENV HOME="/home/user" \
    USER="user" \
    SHELL="/bin/bash" \
    TERM="xterm-256color" \
    LANG="C.UTF-8" \
    LC_ALL="C.UTF-8"

# The WebVM Deploy workflow extracts CMD[0] as the executable and CMD[1:] as
# args. The app's argument parser accepts --user-data-dir before the folder.
# Debug entrypoint: the image can be inspected from a real shell before the
# TUI is launched manually.
CMD ["/bin/bash"]
